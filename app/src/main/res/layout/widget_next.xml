<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.15"
        android:text="СЛЕДУЮЩАЯ ПАРА"
        android:textColor="#FF00E5FF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="—"
        android:textColor="#FFF4F4FF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textColor="#FFB4B4D0"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF8A8AA6"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Chronometer
        android:id="@+id/w_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#FF00E5FF"
        android:shadowRadius="12"
        android:textColor="#FFF4F4FF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_timer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="#FF00E5FF"
        android:shadowRadius="12"
        android:textColor="#FFF4F4FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
